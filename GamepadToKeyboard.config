; Specifies which .ini file to load.
[configToLoad]
configToLoad = default.ini

; ---------------------------------------------------------------
; Hotkey information:
; ^ = Ctrl   |   + = Shift   |   ! = Alt   |   # = Win (modifiers)
;
; - Do NOT use combinations with two or more "base keys".
;   See: https://www.autoitscript.com/autoit3/docs/functions/HotKeySet.htm

; - Set the hotkey in the form ^+5
;   ok:  ^+5
;   not:    {LShift}{LCtrl}5
; ---------------------------------------------------------------
[Hotkey]
ReloadHotkey    = ^+5
StatsHotkey     = ^+6

ShiftModeCycle- = ^+7
ShiftModeCycle+ = ^+8
ShiftModeToggle = ^+9

LayerCycle-     = ^+1
LayerCycle+     = ^+2
LayerToggle     = ^+3



ReloadHotkeyEnabled         = True
StatsHotkeyEnabled          = True

KeyboardShiftEnabled        = False
KeyboardShiftCycleEnabled   = False

KeyboardLayerToggleEnabled  = False
KeyboardLayerCycleEnabled   = False

